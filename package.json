{
  "name": "ilinxa-ui-pro",
  "version": "0.1.0",
  "description": "High-level composed React components for shadcn/ui, distributed as a shadcn registry — kanban, gantt, calendar, media editors, flow canvas, forms, and more.",
  "license": "MIT",
  "homepage": "https://ui.ilinxa.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilinxa/pro-ui.git"
  },
  "keywords": [
    "shadcn",
    "shadcn-registry",
    "react",
    "nextjs",
    "tailwindcss",
    "radix-ui",
    "component-library",
    "ui-components",
    "typescript"
  ],
  "private": true,
  "scripts": {
    "predev": "node scripts/build-source-map.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/build-source-map.mjs",
    "build": "next build",
    "vercel-build": "pnpm run test:run && pnpm run registry:build && pnpm run build:source-map && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:run": "vitest run",
    "test:lib": "vitest run --project lib",
    "test:components": "vitest run --project components",
    "test:repo": "vitest run --project repo",
    "validate:meta-deps": "node scripts/validate-meta-deps.mjs",
    "validate:default-registry-whitelist": "node scripts/validate-default-registry-whitelist.mjs",
    "validate:doc-drift": "node scripts/validate-doc-drift.mjs && node scripts/build-component-versions.mjs --check",
    "validate:doc-budget": "node scripts/validate-doc-budget.mjs",
    "validate:registry-json": "node scripts/validate-registry-json.mjs",
    "validate:naming": "node scripts/validate-naming.mjs",
    "validate:artifact-size": "node scripts/validate-artifact-size.mjs",
    "validate:barrel-exports": "node scripts/validate-barrel-exports.mjs",
    "validate:no-control-chars": "node scripts/validate-no-control-chars.mjs",
    "validate:inert-surfaces": "node scripts/validate-inert-surfaces.mjs",
    "build:llms": "node scripts/build-llms.mjs",
    "build:component-versions": "node scripts/build-component-versions.mjs",
    "build:source-map": "node scripts/build-source-map.mjs",
    "new:component": "node scripts/new-component.mjs",
    "new:migration": "node scripts/new-migration.mjs",
    "registry:build": "node scripts/validate-meta-deps.mjs && node scripts/validate-default-registry-whitelist.mjs && node scripts/validate-registry-json.mjs && node scripts/validate-naming.mjs && node scripts/validate-no-control-chars.mjs && node scripts/validate-barrel-exports.mjs --strict && node scripts/validate-inert-surfaces.mjs --strict && node scripts/build-llms.mjs && node scripts/build-component-versions.mjs && node scripts/validate-doc-drift.mjs && node scripts/validate-doc-budget.mjs && node scripts/clean-registry-artifacts.mjs && shadcn build && node scripts/validate-artifact-size.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/react": "^0.27.19",
    "@fontsource-variable/caveat": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/onest": "^5.2.11",
    "@fontsource-variable/playfair-display": "^5.2.8",
    "@fontsource/kalam": "^5.2.8",
    "@fontsource/patrick-hand": "^5.2.8",
    "@fontsource/shadows-into-light": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.6.3",
    "@platejs/basic-nodes": "^53.0.0",
    "@platejs/basic-styles": "^53.0.0",
    "@platejs/caption": "^53.0.0",
    "@platejs/code-block": "^53.0.0",
    "@platejs/indent": "^53.0.0",
    "@platejs/link": "^53.0.3",
    "@platejs/list": "^53.0.2",
    "@platejs/media": "^53.0.1",
    "@platejs/resizable": "^53.0.0",
    "@platejs/table": "^53.0.0",
    "@react-sigma/core": "5.0.6",
    "@react-sigma/layout-forceatlas2": "5.0.6",
    "@shikijs/transformers": "^4.0.2",
    "@tanstack/react-virtual": "^3.13.24",
    "@xyflow/react": "^12.10.2",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphology-types": "^0.24.8",
    "highlight.js": "^11.11.1",
    "konva": "^10.3.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.11.0",
    "marked": "^18.0.2",
    "next": "16.2.4",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "5.4.296",
    "platejs": "^53.0.3",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.75.0",
    "react-konva": "^19.2.4",
    "react-pdf": "^10.4.1",
    "shadcn": "^4.5.0",
    "shiki": "^4.0.2",
    "sigma": "^3.0.2",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "jsdom": "30.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.10"
  }
}
